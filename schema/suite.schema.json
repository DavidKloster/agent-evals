{
  "$id": "suite.schema.json",
  "title": "Agent eval suite",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "capability",
        "regression"
      ]
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "description": "Who keeps the tasks and graders up to date.",
      "type": "string"
    },
    "tasks": {
      "description": "Task files or folders relative to the suite file (default: tasks/).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "graders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "The grader: a built-in one (README, \"Graders\") or one a project registers."
              },
              "id": {
                "description": "Unique within the task, the suite's default graders counted; defaults to the type (type#2 for the second unnamed one).",
                "type": "string",
                "minLength": 1
              },
              "weight": {
                "description": "The weight in a weighted or hybrid score (default 1).",
                "type": "number",
                "minimum": 0
              },
              "required": {
                "description": "In hybrid scoring, this grader must pass whatever the weighted score.",
                "type": "boolean"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": {},
            "description": "One grader with its parameters; the parameters depend on the grader's type."
          }
        },
        "scoring": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "binary",
                "weighted",
                "hybrid"
              ]
            },
            "threshold": {
              "description": "For weighted and hybrid (default 1).",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "trials": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "context": {
          "description": "Merged under every task's input.context (shared mock tools, the system prompt), or a YAML or JSON file of it, relative to the suite file.",
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "saturation": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "threshold"
      ],
      "additionalProperties": false
    },
    "graduation": {
      "type": "object",
      "properties": {
        "k": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "runs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "k",
        "runs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "kind"
  ],
  "additionalProperties": false
}
